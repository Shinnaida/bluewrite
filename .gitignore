# Huge local Laragon installer — GitHub rejects files over 100 MB
laragon-wamp.exe

# Downloaded on-device OCR models (342 MB of ONNX binaries) — fetched at
# setup, not source. GitHub rejects files over 100 MB, so these live here
# untracked, like the installer above.
bluewrite/public/handwriting/
bluewrite/public/ocr/

# Working backups incl. a SQL dump of real reports — NEVER publish
.design-backup/

# Source requirement documents (kept local, not part of the code repo)
BLUEWRITE.docx
bluewrite_extracted.txt

# Machine-local tool state
.freebuff/

# Scratch artifacts from UI probing (dumped pages, screenshots, probe scripts),
# written at the repo root and under bluewrite/ while a surface is being measured.
# They are working files, not source: never commit them.
.tmp-*

# Build/probe logs and JVM crash dumps (the launcher and the phone app's Gradle
# daemon write these beside the code)
*.log

# Editor-local launch files and draw.io scratch: backups, temp files, and the
# stray .class files a draw.io export leaves behind
.vscode/
*.drawio.bkp
*.drawio.dtmp
.$*
*.class

# A stray shell-redirect artifact (`echo > ^`)
^

# OS junk
Thumbs.db
.DS_Store
