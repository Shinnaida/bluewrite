# Secrets
config/config.php
app/config/ai.php
# The mail the 'log' transport writes instead of sending (dev and tests only).
# It holds real sign-in codes in readable form, because that is the point of it —
# a test has to be able to read what the server would have emailed.
config/mail.log

# A leftover from the authenticator-app factor (migration 012). Nothing writes
# it any more, but an old deployment may still have one, and it is a key.
config/mfa.key

# Machine-local Gemini cache state (CachedInstructionStore)
resources/ai/.cache_state.json

# Uploaded avatars (migration 014). These are OFFICER PHOTOGRAPHS, and they are user
# data rather than source: one file per account, written by POST /me/photo, and
# outside public/ precisely so a build cannot wipe them (see AvatarPhoto). The
# folder is created on demand, so an empty checkout has nothing here at all.
storage/avatars/

# Dependencies & build
node_modules/
public/assets/
phpunit.phar
.phpunit.result.cache

# scripts/export-offline.php — the browsable copy of the register that opens with
# no server at all (file://), written where the app can be found on disk. It is
# STATION DATA — real reports and real narratives — so it is never committed: an
# export is something an officer makes on a workstation, not a file in the repo.
offline-copy/

# Misc
.DS_Store
Thumbs.db
*.log
